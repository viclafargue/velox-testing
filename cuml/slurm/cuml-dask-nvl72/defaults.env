#!/bin/bash
# ==============================================================================
# Cluster & path defaults for cuML Dask KMeans benchmark scripts.
# ==============================================================================

# Workspace identifier (per-clone isolation).
_vt_path="${VT_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/../../.." 2>/dev/null && pwd)}"
: "${VT_WORKSPACE:=$(echo "${_vt_path#${HOME}/}" | tr '/' '-')}"
unset _vt_path

# Scratch paths.
: "${IMAGE_DIR:=/scratch/${USER}/images/cuml}"
: "${DATASET_ROOT:=/scratch/${USER}/datasets/cuml-kmeans}"

# Output path.
: "${RESULTS_BASE:=${HOME}/${VT_WORKSPACE}/results}"

# Dask defaults.
: "${DASK_SCHEDULER_PORT:=8786}"
: "${DASK_DASHBOARD_PORT:=8787}"
: "${DASK_PROTOCOL:=tcp}"
